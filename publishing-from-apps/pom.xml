<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
   <modelVersion>4.0.0</modelVersion>

   <!--
      Companion code for https://orbitalhq.com/docs/guides/generating-taxi-from-code

      This demo publishes its schemas with Orbital's schema-publisher-spring-boot-starter, which needs
      Spring Boot 4 and Java 21, so unlike the other demos it uses the Spring Boot parent directly
      rather than the (Spring Boot 2.7) demos parent one directory up. Build it from this directory:

         mvn package -DskipTests
   -->
   <parent>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-parent</artifactId>
      <version>4.0.6</version>
      <relativePath/>
   </parent>

   <groupId>com.orbitalhq.demos</groupId>
   <artifactId>publishing-from-apps</artifactId>
   <version>1.0-SNAPSHOT</version>
   <packaging>pom</packaging>

   <properties>
      <java.version>21</java.version>
      <kotlin.version>2.2.21</kotlin.version>
      <!-- The Orbital release the starter comes from. Both Orbital and Taxi artifacts are served
           from https://repo.orbitalhq.com/release (see <repositories> below). -->
      <orbital.version>0.39.1-M1</orbital.version>
      <!-- The Taxi version that Orbital release was built against. Used for the taxonomy module;
           the services get java2taxi / java-spring-taxi transitively from the starter. -->
      <taxi.version>1.72.0</taxi.version>
      <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
   </properties>

   <modules>
      <!-- The Kotlin type aliases for the shared semantic types (FilmId, ReviewText, ...) -->
      <module>films-taxonomy</module>
      <module>film-listing-api</module>
      <module>id-resolution-service</module>
      <module>squashed-tomatoes-ratings</module>
      <!-- kotlin-sdk-consumer depends on com.orbitalhq:kotlin-client:0.2.0-SNAPSHOT, which is no
           longer published, so it's left out of the build until it's ported to the current JVM SDK
           (https://orbitalhq.com/docs/sdks/java-and-kotlin/jvm-query-sdk). -->
      <!-- <module>kotlin-sdk-consumer</module> -->
   </modules>

   <dependencies>
      <dependency>
         <groupId>org.jetbrains.kotlin</groupId>
         <artifactId>kotlin-stdlib</artifactId>
      </dependency>
      <dependency>
         <groupId>org.jetbrains.kotlin</groupId>
         <artifactId>kotlin-reflect</artifactId>
      </dependency>
   </dependencies>

   <build>
      <finalName>${project.artifactId}</finalName>
      <plugins>
         <plugin>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-maven-plugin</artifactId>
            <version>${kotlin.version}</version>
            <configuration>
               <jvmTarget>${java.version}</jvmTarget>
               <args>
                  <arg>-Xjsr305=strict</arg>
               </args>
               <compilerPlugins>
                  <!-- Opens Spring-annotated classes, so @Configuration / @RestController etc. work -->
                  <plugin>spring</plugin>
               </compilerPlugins>
            </configuration>
            <executions>
               <execution>
                  <id>compile</id>
                  <phase>compile</phase>
                  <goals>
                     <goal>compile</goal>
                  </goals>
                  <configuration>
                     <sourceDirs>
                        <sourceDir>${project.basedir}/src/main/java</sourceDir>
                     </sourceDirs>
                  </configuration>
               </execution>
               <execution>
                  <id>test-compile</id>
                  <phase>test-compile</phase>
                  <goals>
                     <goal>test-compile</goal>
                  </goals>
                  <configuration>
                     <sourceDirs>
                        <sourceDir>${project.basedir}/src/test/java</sourceDir>
                     </sourceDirs>
                  </configuration>
               </execution>
            </executions>
            <dependencies>
               <dependency>
                  <groupId>org.jetbrains.kotlin</groupId>
                  <artifactId>kotlin-maven-allopen</artifactId>
                  <version>${kotlin.version}</version>
               </dependency>
            </dependencies>
         </plugin>
      </plugins>
   </build>

   <repositories>
      <repository>
         <id>orbital-releases</id>
         <url>https://repo.orbitalhq.com/release</url>
      </repository>
   </repositories>
</project>
